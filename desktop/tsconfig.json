{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["svelte"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["renderer/src/**/*.ts", "renderer/src/**/*.svelte"]
}
