{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // `lib/appearance.ts` 被 node --test 直接加载，需要显式 .ts 扩展名（见该文件注释）
    "allowImportingTsExtensions": true,
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["svelte"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"]
  },
  "include": ["renderer/src/**/*.ts", "renderer/src/**/*.svelte"]
}
