{
  "版本": 1,
  "预设": {
    "日语 ASMR：耳语·低底噪（Whisper 默认）": {
      "引擎": "whisper",
      "参数": {
        "whisper.enable_sentence_split": true,
        "whisper.enable_loudnorm": true,
        "whisper.vad_threshold": 0.25,
        "whisper.vad_speech_pad_ms": 250,
        "whisper.vad_onset_pad_ms": 0,
        "whisper.vad_min_silence_ms": 200,
        "whisper.vad_min_speech_ms": 80,
        "whisper.vad_merge_gap_s": 0.3,
        "whisper.vad_max_segment_s": 9.0,
        "whisper.vad_min_speech_s": 0.08,
        "whisper.cue_pad_s": 0.02,
        "whisper.strip_nonverbal_edges": true,
        "whisper.use_ctc_alignment": false,
        "whisper.no_repeat_ngram_size": 5,
        "whisper.repetition_penalty": 1.15
      }
    },
    "日语 ASMR：耳语·低底噪（Qwen3 默认）": {
      "引擎": "qwen",
      "参数": {
        "qwen.enable_loudnorm": true,
        "qwen.use_alignment": true,
        "qwen.vad_threshold": 0.3,
        "qwen.vad_min_speech_ms": 100,
        "qwen.vad_min_silence_ms": 200,
        "qwen.vad_speech_pad_ms": 250,
        "qwen.vad_onset_pad_ms": 400,
        "qwen.merge_gap_s": 0.5,
        "qwen.max_segment_s": 12.0,
        "qwen.min_pause_s": 0.12,
        "qwen.max_cue_dur": 4.3,
        "qwen.max_cue_chars": 21,
        "qwen.cue_pad_start_s": 0.2,
        "qwen.cue_pad_end_s": 0.45,
        "qwen.strip_nonverbal_edges": true
      }
    },
    "中文短视频：快节奏·带 BGM（SenseVoice 默认）": {
      "引擎": "sensevoice",
      "参数": {
        "sensevoice.enable_loudnorm": true,
        "sensevoice.use_itn": true,
        "sensevoice.num_threads": 2,
        "sensevoice.vad_threshold": 0.3,
        "sensevoice.vad_min_speech_ms": 100,
        "sensevoice.vad_min_silence_ms": 200,
        "sensevoice.vad_speech_pad_ms": 150,
        "sensevoice.merge_gap_s": 0.5,
        "sensevoice.max_segment_s": 10.0,
        "sensevoice.min_pause_s": 0.2,
        "sensevoice.max_cue_dur": 4.3,
        "sensevoice.max_cue_chars": 14,
        "sensevoice.cue_pad_s": 0.1
      }
    },
    "中文短视频：快节奏·带 BGM（FireRed 默认）": {
      "引擎": "firered",
      "参数": {
        "firered.enable_loudnorm": true,
        "firered.use_punc": true,
        "firered.num_threads": 2,
        "firered.vad_threshold": 0.3,
        "firered.vad_min_speech_ms": 100,
        "firered.vad_min_silence_ms": 200,
        "firered.vad_speech_pad_ms": 150,
        "firered.merge_gap_s": 0.35,
        "firered.max_segment_s": 20.0,
        "firered.min_pause_s": 0.24,
        "firered.max_cue_dur": 4.3,
        "firered.max_cue_chars": 14,
        "firered.energy_align": true,
        "firered.cue_pad_s": 0.1
      }
    }
  }
}
